---
import '../../styles/base.css';
import AppLayout from "../../Layouts/AppLayout.astro";
import Star from "../../components/icons/star.astro";
import Apple from '../../components/icons/apple.astro'
import Android from '../../components/icons/android.astro'
import Windows from '../../components/icons/windows.astro'
import VideoPlayer from '../../components/VideoPlayer.astro';
import DownloadModal from '../../components/DownloadModal.astro';

const { slug } = Astro.params;

const res = await fetch(`${import.meta.env.STRAPI_URL}/api/communications?filters[slug][$eq]=${slug}&populate=*`, {
    headers: { Authorization: `Bearer ${import.meta.env.STRAPI_TOKEN}` }
});
const json = await res.json();

console.log('Strapi response:', JSON.stringify(json, null, 2));

const entry = json.data?.[0];

if (!entry) return Astro.redirect('/404');

const data = entry;
const thumbnailUrl = data.thumbnail?.url ?? data.thumbnail ?? '';
const bannerUrl = data.banner?.url ?? data.banner ?? '';
const backgroundHero = `background-image: linear-gradient(0deg, rgba(0,0,0,1) 0%, rgba(0,0,0,0.5) 98%), url('${bannerUrl}')`;
---

<AppLayout title={data.title} description={data.summary} image={thumbnailUrl}>

  <section style={backgroundHero} class="bg-cover bg-center bg-fixed" transition:name={data.title}>
    <div class="mx-auto pt-20 md:px-5 max-w-screen-xl w-full flex p-5">
      <div class="dark:bg-gray-800 dark:border-gray-700 rounded-lg mb-8">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-white dark:text-white text-3xl md:text-5xl font-bold mb-2">{data.title}</h1>
            <div class="flex gap-2 items-center">
              <p class="text-gray-300"></p>
              {data.apk && <Android color="#22c55e" size="w-5"/>}
              {data.windows && <Windows color="#0ea5e9" size="w-5"/>}
              {data.mac && <Apple color="#9ca3af" size="w-5"/>}
            </div>
            <p class="text-white py-5 font-bo md:leading-6 pr-0 md:pr-10 lg:pr-10">{data.summary}</p>
          </div>
          <img src={thumbnailUrl} alt="" class="rounded-xl w-32 h-32 hidden md:block">
        </div>

        <br>
        <div class="py-15 text-white grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-4 text-sm backdrop-blur-lg bg-slate-900/90 rounded-2xl font-bo">
          <div class="text-center p-3 border-slate-700 border-r-0 sm:border-r-0 md:border-r-2 lg:border-r-2">
            <p>བཟོ་སྐྲུན་པ།:</p>
            <p class="font-bold pt-2">{data.author}</p>
          </div>
          <div class="text-center p-3 border-slate-700 border-r-0 sm:border-r-0 md:border-r-2 lg:border-r-2">
            <p>གཞུང་ཕྱོགས་དྲ་ཚིགས།:</p>
            <p class="font-bold pt-2">{data.website}</p>
          </div>
          <div class="text-center p-3 border-slate-700 border-r-0 sm:border-r-0 md:border-r-2 lg:border-r-2">
            <p>རྒྱལ་ཁབ།:</p>
            <p class="font-bold pt-2">{data.country}</p>
          </div>
          <div class="flex text-center p-3 flex-col">
            <p class="pb-2">ཐོབ་ཆ།:</p>
            <div class="flex justify-center">
              <Star/>
              <p>{data.rating}</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-3 gap-6 py-10">
          {data.apk &&
            <a href={data.apk} type="button">
              <div class="flex flex-col p-2 w-full justify-center bg-green-500 hover:bg-green-400 items-center rounded-lg">
                <div class="text-slate-700 h-10 text-sm inline-flex items-center px-5 py-2.5 text-center">
                  <Android color="white" size="w-8"/> <span class="px-2 text-lg font-bold text-white">Android</span>
                </div>
                <p class="text-xs pb-3 text-white">Version: {data.apk_version}</p>
              </div>
            </a>
          }
          {data.windows &&
            <a href={data.windows} type="button">
              <div class="flex flex-col p-2 w-full justify-center bg-blue-600 hover:bg-blue-700 items-center rounded-lg">
                <div class="text-slate-700 h-10 text-sm inline-flex items-center px-5 py-2.5 text-center">
                  <Windows color="white" size="w-8"/> <span class="px-2 text-lg font-bold text-white">Windows</span>
                </div>
                <p class="text-xs pb-3 text-white">Version: {data.win_version}</p>
              </div>
            </a>
          }
          {data.mac &&
            <a href={data.mac} type="button">
              <div class="flex flex-col p-2 w-full justify-center bg-gray-500 hover:bg-gray-600 items-center rounded-lg">
                <div class="text-slate-700 h-10 text-sm inline-flex items-center px-5 py-2.5 text-center">
                  <Apple color="white" size="w-8"/> <span class="px-2 text-lg font-bold text-white">Apple Mac</span>
                </div>
                <p class="text-xs pb-3 text-white">Version: {data.mac_version}</p>
              </div>
            </a>
          }
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-screen-xl mx-auto p-10">
    <div id="accordion-flush" data-accordion="collapse" data-active-classes="dark:bg-gray-900 text-gray-900 dark:text-white" data-inactive-classes="text-gray-500 dark:text-gray-400">
      <h2 id="accordion-flush-heading-1">
        <button type="button" class="flex items-center justify-between w-full py-5 font-medium rtl:text-right text-gray-500 border-b border-gray-700 dark:border-gray-700 dark:text-gray-400 gap-3" data-accordion-target="#accordion-flush-body-1" aria-expanded="true" aria-controls="accordion-flush-body-1">
          <svg data-accordion-icon class="w-3 h-3 rotate-180 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5"/>
          </svg>
        </button>
      </h2>
      <div id="accordion-flush-body-1" class="hidden" aria-labelledby="accordion-flush-heading-1">
        <div class="py-5 border-b border-gray-700 dark:border-gray-700 font-bo leading-relaxed text-gray-300"
          set:html={data.description ?? data.summary}>
        </div>
      </div>

      {data.video &&
        <h2 id="accordion-flush-heading-2">
          <button type="button" class="flex items-center justify-between w-full py-5 font-medium rtl:text-right text-gray-500 border-b border-gray-700 dark:border-gray-700 dark:text-gray-400 gap-3" data-accordion-target="#accordion-flush-body-2" aria-expanded="false" aria-controls="accordion-flush-body-2">
            <span class="text-2xl text-gray-300">བརྙན་པར་སློབ་ཁྲིད།</span>
            <svg data-accordion-icon class="w-3 h-3 rotate-180 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5"/>
            </svg>
          </button>
        </h2>
        <div id="accordion-flush-body-2" class="hidden" aria-labelledby="accordion-flush-heading-2">
          <VideoPlayer video={data.video}/>
        </div>
      }
    </div>
  </section>

  <DownloadModal>
    {data.apk &&
      <div class="flex flex-col p-2 w-full justify-center bg-green-500 hover:bg-green-400 items-center">
        <a href={data.apk} data-modal-hide="popup-modal" type="button" class="text-slate-700 h-10 text-sm inline-flex items-center px-5 py-2.5 text-center">
          <Android color="white"/> <span class="px-2 text-lg font-bold text-white">Android</span>
        </a>
        <p class="text-xs pb-3 text-white">V: {data.apk_version}</p>
      </div>
    }
    {data.windows &&
      <div class="flex flex-col p-2 w-full justify-center bg-blue-600 hover:bg-blue-700 items-center">
        <a href={data.windows} data-modal-hide="popup-modal" type="button" class="text-slate-700 h-10 text-sm inline-flex items-center px-5 py-2.5 text-center">
          <Windows color="white"/> <span class="px-2 text-lg font-bold text-white">Windows</span>
        </a>
        <p class="text-xs pb-3 text-white">V: {data.win_version}</p>
      </div>
    }
    {data.mac &&
      <div class="flex flex-col p-2 w-full justify-center bg-gray-500 hover:bg-gray-600 items-center">
        <a href={data.mac} data-modal-hide="popup-modal" type="button" class="text-slate-700 h-10 text-sm inline-flex items-center px-5 py-2.5 text-center">
          <Apple color="white"/> <span class="px-2 text-lg font-bold text-white">Mac</span>
        </a>
        <p class="text-xs pb-3 text-white">V: {data.mac_version}</p>
      </div>
    }
  </DownloadModal>

</AppLayout> 